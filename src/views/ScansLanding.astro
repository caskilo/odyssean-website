---
import Scans from '../layouts/Scans.astro';
import Eyebrow from '../components/core/Eyebrow.astro';
import Headline from '../components/core/Headline.astro';
import CopyText from '../components/core/Copy.astro';
import { getArt } from '../lib/art';
import { getSignals, type PageOf } from '../lib/content';
import { text } from '../lib/copy';

interface Props {
  entry: PageOf<'scans-landing'>;
}
const { data } = Astro.props.entry;
const signals = await getSignals();
const num = (n: number) => String(n).padStart(2, '0');
const Tracks = getArt('signal-tracks').Component;
---

<Scans title={data.title} description={data.description}>
  <div class="container container--narrow scans" data-signals>
    <div class="intro">
      <div class="intro__title">
        <Eyebrow>
          <CopyText value={data.eyebrow} />
        </Eyebrow>
        <Headline text={data.headline.text} accent={data.headline.accent} roman size="landing" />
      </div>
      <p class="intro__aside">
        <CopyText value={data.aside} />
      </p>
    </div>

    <div class="board">
      <div class="chart">
        <Tracks
          numbers={signals.map((s) => num(s.data.rank))}
          origin={text(data.originLabel) ?? ''}
          description={text(data.title) ?? ''}
        />
      </div>
      <div class="side">
        <ul class="picker" data-picker hidden>
          {signals.map((s) => (
            <li>
              <button type="button" data-pick aria-pressed="false">
                <span class="picker__num">{num(s.data.rank)}</span>
                <span class="picker__title">{s.data.title}</span>
              </button>
            </li>
          ))}
        </ul>
        {signals.map((s) => (
          <article class="card" data-panel>
            <div class="card__meta">
              <CopyText value={data.signalLabel} /> {num(s.data.rank)}
            </div>
            <h2 class="card__title">{s.data.title}</h2>
            <p>
              <CopyText value={s.data.summary} />
            </p>
            <a class="tap" href={data.readMore.href}>
              <CopyText value={data.readMore.label} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</Scans>

<script>
  import '../scripts/signals';
</script>

<style>
  .scans {
    padding-block: 3.5rem 4rem;
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .intro__title {
    max-width: 45rem;
    --eyebrow-gap: 1.125rem;
    --heading-wrap: wrap;
  }

  .intro__aside {
    max-width: 23.75rem;
    margin: 0;
    line-height: 1.6;
    color: var(--accent);
  }
  .board {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }
  .chart {
    flex: 3 1 35rem;
    min-width: 0;
    border: 1px solid var(--blue);
  }
  .side {
    flex: 2 1 21.25rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .picker {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .picker[hidden] {
    display: none;
  }
  .picker button {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--blue);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .picker button[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--gold);
  }
  .picker__num {
    min-width: 1.625rem;
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    color: var(--gold);
  }
  .picker__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.625rem 1.75rem;
    background: var(--surface);
    color: var(--surface-fg);
  }
  .card[hidden] {
    display: none;
  }
  .picker:not([hidden]) ~ .card:not([hidden]) {
    margin-top: 0.875rem;
  }
  .card__meta {
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    color: var(--blue);
  }
  .card__title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .card p {
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.6;
  }
  .card a {
    color: var(--blue);
    font-size: var(--step-small);
  }
</style>
