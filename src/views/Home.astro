---
import InfoLanding from '../layouts/InfoLanding.astro';
import Headline from '../components/core/Headline.astro';
import Card from '../components/core/Card.astro';
import CopyText from '../components/core/Copy.astro';
import { getArt } from '../lib/art';
import type { PageOf } from '../lib/content';

interface Props {
  entry: PageOf<'home'>;
}
const { data } = Astro.props.entry;
const { Component: Horizon } = getArt(data.hero.art);
const rules = { institutions: 'blue', wellbeing: 'gold', resilience: 'navy' } as const;
---

<InfoLanding title={data.title} fullTitle description={data.description} headerVariant="overlay">
  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <Horizon />
    </div>
    <div class="container hero__inner">
      <Headline
        text={data.hero.headline.text}
        accent={data.hero.headline.accent}
        size="hero"
        breakBefore
      />
      <p class="hero__lede">
        <CopyText value={data.hero.lede} />
      </p>
    </div>
  </section>

  <div class="bands" aria-hidden="true">
    <span class="bands__blue"></span>
    <span class="bands__gold"></span>
    <span class="bands__sand"></span>
  </div>

  <section class="container focus">
    <div class="focus__head">
      <h2>
        <CopyText value={data.focus.heading} />
      </h2>
      <a class="tap" href={data.focus.more.href}>
        <CopyText value={data.focus.more.label} />
      </a>
    </div>
    <div class="focus__cards">
      {data.focus.cards.map((c) => (
        <Card href={c.href} rule={rules[c.area]} label={c.label} title={c.title} note={c.note} />
      ))}
    </div>
  </section>
</InfoLanding>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    --accent: var(--sand);
    min-height: 40rem;
    padding-top: 13.375rem;
    background: var(--navy);
    color: var(--paper);
  }
  .hero__art {
    position: absolute;
    inset: 0;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    max-width: 62.5rem;
    padding-bottom: 6rem;
    text-align: center;
  }

  .hero__lede {
    max-width: 37.5rem;
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.6;
  }
  .bands {
    display: flex;
    flex-direction: column;
  }
  .bands__blue {
    height: 18px;
    background: var(--blue);
  }
  .bands__gold {
    height: 12px;
    background: var(--gold);
  }
  .bands__sand {
    height: 10px;
    background: var(--sand);
  }
  .focus {
    padding-block: 4rem 4.5rem;
  }
  .focus__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }
  .focus__head h2 {
    margin: 0;
    line-height: normal;
    font-size: var(--step-m);
  }
  .focus__head a {
    font-size: var(--step-small);
    font-weight: 600;
  }
  .focus__cards {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
