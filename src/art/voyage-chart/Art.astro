---
import { Image } from 'astro:assets';
import strait from './strait-of-messina.jpg';

interface Props {
  /** the chart's accessible name; it is not drawn */
  title: string;
}
const { title } = Astro.props;
const ports = [
  { n: 'I', x: 170, y: 300 },
  { n: 'II', x: 560, y: 215 },
  { n: 'III', x: 1040, y: 262 },
];
---

<div class="art" role="img" aria-label={title}>
  <Image
    class="art__photo"
    src={strait}
    alt=""
    widths={[1160, 2400]}
    sizes="(min-width: 80rem) 1180px, 100vw"
    loading="eager"
  />
  <svg viewBox="0 0 1160 420" class="art__route" aria-hidden="true">
    <path
      d="M170 300 C270 190 420 110 560 215 C680 305 820 320 930 268 C990 240 1020 246 1040 262"
      fill="none"
      stroke="#E2B540"
      stroke-width="3"
      stroke-dasharray="10 8"
      stroke-linecap="round"
    ></path>
    {ports.map((p) => (
      <>
        <circle
          class="port"
          cx={p.x}
          cy={p.y}
          r="22"
          fill="#011130"
          stroke="#E2B540"
          stroke-width="1.5"
        ></circle>
        <text
          class="port-num"
          x={p.x}
          y={p.y + 6}
          text-anchor="middle"
          fill="#E2B540"
          font-family="Arrus BT, Georgia, serif"
          font-size="18"
        >
          {p.n}
        </text>
      </>
    ))}
  </svg>
</div>

<style>
  .art {
    position: relative;
    aspect-ratio: 1160 / 420;
    background: #1d4387;
  }
  .art :global(.art__photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art__route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* phone width: enlarge the port markers (mobile: interim) */
  @media (max-width: 40rem) {
    .port {
      r: 34px;
    }
    .port-num {
      font-size: 34px;
      dominant-baseline: central;
      translate: 0 -6px;
    }
  }
</style>
