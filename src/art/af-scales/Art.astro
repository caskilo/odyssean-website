---
interface Props {
  labels: { macro: string; micro: string; meso: string; centre: string };
  description: string;
}
const { labels, description } = Astro.props;
---

<svg viewBox="0 0 400 400" class="art" role="img" aria-label={description}>
  <g fill="#F4F4F2" fill-opacity="0.05" stroke="#F4F4F2" stroke-width="1.6">
    <circle cx="200" cy="152" r="95" />
    <circle cx="160" cy="221" r="95" />
    <circle cx="240" cy="221" r="95" />
  </g>
  <g
    font-family="'DM Mono', monospace"
    font-size="11"
    letter-spacing="2"
    fill="#F4F4F2"
    text-anchor="middle"
    style="text-transform: uppercase"
  >
    <text x="200" y="98">
      {labels.macro}
    </text>
    <text x="118" y="250">
      {labels.micro}
    </text>
    <text x="282" y="250">
      {labels.meso}
    </text>
    <text x="200" y="204" font-size="9" fill="#A9A9A6">
      {labels.centre}
    </text>
  </g>
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
  }
</style>
