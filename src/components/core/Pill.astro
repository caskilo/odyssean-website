---
interface Props {
  href: string;
  current?: boolean;
}
const { href, current = false } = Astro.props;
---

<a
  class:list={['pill', { 'pill--current': current }]}
  {href}
  aria-current={current ? 'true' : undefined}
>
  <slot />
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 1.375rem;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--accent);
    font-size: var(--step-small);
    text-decoration: none;
  }
  .pill:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .pill--current {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .pill--current:hover {
    color: var(--bg);
  }
</style>
