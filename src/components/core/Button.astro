---
import { isRequest, type ContentRequest } from '../../lib/copy';

interface Props {
  href: string | ContentRequest;
  style?: 'primary' | 'secondary' | 'accent' | 'donate';
  size?: 'default' | 'small';
  /** gold label on the primary button (concept 10) */
  goldText?: boolean;
}
const { href, style = 'primary', size = 'default', goldText = false } = Astro.props;
const pending = isRequest(href);
const external = !pending && /^https?:\/\//.test(href);
---

{pending ? (
  <span
    class:list={['btn', `btn--${style}`, `btn--${size}`, 'btn--pending']}
    data-request={href.request}
    title={href.note}
  >
    <slot />
  </span>
) : (
  <a
    class:list={['btn', `btn--${style}`, `btn--${size}`, { 'btn--gold-text': goldText }]}
    href={href}
    {...(external ? { rel: 'noopener' } : {})}
  >
    <slot />
  </a>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 1rem 1.625rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--step-small);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .btn--small {
    padding: 0.8125rem 1.375rem;
    font-size: 0.875rem;
  }
  .btn--primary {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .btn--primary:hover {
    color: var(--btn-fg);
    filter: brightness(1.25);
  }
  .btn--primary.btn--gold-text,
  .btn--primary.btn--gold-text:hover {
    color: var(--gold);
  }
  .btn--secondary {
    border-color: var(--link);
    color: var(--link);
  }
  .btn--secondary:hover {
    border-color: var(--link-hover);
  }
  .btn--accent {
    padding: 0.75rem 1.25rem;
    background: var(--gold);
    color: var(--navy);
  }
  .btn--accent:hover {
    color: var(--navy);
    filter: brightness(1.08);
  }
  .btn--donate {
    padding: 0.6875rem 1.25rem;
    border-color: var(--gold);
    color: var(--gold);
  }
  .btn--donate:hover {
    background: var(--gold);
    color: var(--navy);
  }
  .btn--pending {
    cursor: not-allowed;
    border: 1.5px dashed currentColor;
    background: transparent;
    color: inherit;
    opacity: 0.7;
  }
</style>
