---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Copy } from '../../lib/copy';
import CopyText from './Copy.astro';

interface Props {
  type: Copy;
  title: Copy;
  href: string;
  meta?: Copy[];
  /** heading level of the title: h3 under a section heading, h2 directly under the page h1 */
  tag?: 'h2' | 'h3';
  /** a small preview picture at the end of the row (decorative: the title says what it is) */
  thumb?: ImageMetadata;
}
const { type, title, href, meta = [], tag: Tag = 'h3', thumb } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<article class="row">
  <div class="row__type">
    <CopyText value={type} />
  </div>
  <div class="row__main">
    <Tag class="row__title">
      <a class="tap" {href} {...(external ? { rel: 'noopener' } : {})}>
        <CopyText value={title} />
      </a>
    </Tag>
    {meta.length > 0 && (
      <p class="row__meta">
        {meta.map((m, i) => (
          <>
            {i > 0 && ' · '}
            <CopyText value={m} />
          </>
        ))}
      </p>
    )}
  </div>
  {thumb && (
    <Image class="row__thumb" src={thumb} alt="" width={176} height={132} densities={[1, 2]} />
  )}
</article>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: var(--row-rule-width, 1px) solid var(--rule-soft);
  }
  .row__type {
    flex: 0 0 8.75rem;
    font-family: var(--font-mono);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    color: var(--accent);
  }
  .row__main {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .row__title {
    margin: 0 0 0.5rem;
    font-size: var(--step-s);
  }
  .row__title a {
    color: var(--fg);
    text-decoration: none;
  }
  .row__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }
  .row :global(.row__thumb) {
    flex: 0 0 5.5rem;
    width: 5.5rem;
    height: 4.125rem;
    align-self: flex-start;
    object-fit: cover;
    background: var(--sand);
  }
  .row__body :global(p) {
    margin: 0.75rem 0 0;
    font-size: var(--step-small);
  }
  .row__body:empty {
    display: none;
  }
  .row__meta {
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.6;
  }
</style>
