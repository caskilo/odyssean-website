---
import type { Copy } from '../../lib/copy';
import { markCurrent } from '../../lib/site';
import CopyText from './Copy.astro';
import Logo from './Logo.astro';
import Menu from './Menu.astro';
import NavDrop from './NavDrop.astro';

interface Link {
  label: Copy;
  href: string;
}
interface Props {
  variant: 'overlay' | 'bar' | 'plain';
  current: string;
  /** the info sections, or the current project's sub-nav (named) */
  section: { name?: Copy; links: Link[] };
  /** on every page: a menu of the projects, opened from a link to their overview */
  projects: { label: Copy; href: string; groups: { label: Copy; items: Link[] }[] };
  /** on every page: a menu of the remaining links */
  more: { label: Copy; items: Link[] };
  logoTone: 'blue' | 'paper' | 'gold';
  narrow?: boolean;
  ui: { home: string; menu: string; nav: string };
}
const { variant, current, section, projects, more, logoTone, narrow = false, ui } = Astro.props;
// the Projects menu takes the place of a section link to the overview (the info strand), or follows the section's links (a project)
const sectionLinks = markCurrent(section.links, current);
const slot = sectionLinks.findIndex((l) => l.href === projects.href);
const items = sectionLinks.map((l, i) => (i === slot ? ('projects' as const) : l));
if (slot < 0) items.push('projects');
---

<header class={`site-header site-header--${variant}`}>
  <div class:list={['container', { 'container--narrow': variant === 'bar' || narrow }]}>
    <div class="site-header__inner">
      <a class="site-header__logo" href="/" aria-label={ui.home}>
        <Logo tone={logoTone} height={variant === 'bar' ? 46 : 52} />
      </a>
      <nav class="site-header__nav" aria-label={ui.nav}>
        {items.map((l) =>
          l === 'projects' ? (
            <NavDrop
              label={projects.label}
              href={projects.href}
              groups={projects.groups}
              {current}
            />
          ) : (
            <a href={l.href} aria-current={l.current}>
              <CopyText value={l.label} />
            </a>
          ),
        )}
        <NavDrop label={more.label} groups={[{ items: more.items }]} {current} />
      </nav>
      <Menu
        label={ui.menu}
        navLabel={ui.nav}
        {current}
        groups={[
          { name: section.name, links: section.links },
          { name: projects.label, links: projects.groups.flatMap((g) => g.items) },
          { links: more.items },
        ]}
      />
    </div>
  </div>
</header>

<script>
  import '../../scripts/nav';
</script>

<style>
  .site-header {
    --h-bg: var(--bg);
    --h-fg: var(--fg);
    --h-current: var(--gold);
    color: var(--h-fg);
  }
  .site-header--overlay,
  .site-header--bar {
    --h-bg: var(--navy);
    --h-fg: var(--paper);
  }
  .site-header--bar {
    background: var(--navy);
  }
  .site-header--overlay {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 5;
    --nav-link: var(--sand);
  }
  .site-header--plain {
    --nav-link: var(--fg);
    --h-current: var(--current, var(--accent));
  }
  .site-header--bar {
    --nav-link: var(--paper);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
  }
  .site-header--bar .site-header__inner {
    padding-block: 1.125rem;
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    line-height: 0;
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    font-size: var(--step-small);
  }
  .site-header--bar .site-header__nav {
    font-size: 0.875rem;
    gap: 0.75rem 1.625rem;
  }
  .site-header__nav > a {
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    color: var(--nav-link);
    text-decoration: none;
  }
  .site-header__nav > a:hover,
  .site-header__nav :global(.drop__trigger:hover),
  .site-header__nav :global(.drop:focus-within .drop__trigger) {
    color: var(--h-current);
  }
  .site-header__nav > a[aria-current],
  .site-header__nav :global(.drop__trigger[aria-current]) {
    color: var(--h-current);
    border-bottom-color: var(--h-current);
  }
  /* the last menu opens leftwards so it stays inside the page */
  .site-header__nav > :global(.drop:last-child .drop__panel) {
    right: -1rem;
    left: auto;
  }
  @media (max-width: 48rem) {
    .site-header__nav {
      display: none;
    }
    .site-header__inner {
      flex-wrap: nowrap;
      padding-block: 1.125rem;
    }
  }
</style>
