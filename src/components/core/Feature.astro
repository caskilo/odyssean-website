---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Copy } from '../../lib/copy';
import Button from './Button.astro';
import CopyText from './Copy.astro';

interface Props {
  label: Copy;
  title: Copy;
  href: string;
  cta: Copy;
  meta?: Copy[];
  image?: ImageMetadata;
  rule?: 'blue' | 'gold';
  hidden?: boolean;
}
const { label, title, href, cta, meta = [], image, rule = 'blue', ...attrs } = Astro.props;
---

<article class={`feature feature--${rule}`} {...attrs}>
  {image && <Image class="feature__image" src={image} alt="" width={288} densities={[1, 2]} />}
  <div class="feature__main">
    <p class="feature__label">
      <CopyText value={label} />
    </p>
    <h3 class="feature__title">
      <CopyText value={title} />
    </h3>
    {meta.length > 0 && (
      <p class="feature__meta">
        {meta.map((m, i) => (
          <>
            {i > 0 && ' · '}
            <CopyText value={m} />
          </>
        ))}
      </p>
    )}
    <div class="feature__summary">
      <slot />
    </div>
    <div class="feature__cta">
      <Button {href} size="small">
        <CopyText value={cta} />
      </Button>
    </div>
  </div>
</article>

<style>
  .feature {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    height: 100%;
    padding: 2rem;
    background: var(--paper-light);
    border-top: 3px solid var(--blue);
  }
  .feature--gold {
    border-top-color: var(--gold);
  }
  .feature[hidden] {
    display: none;
  }
  .feature :global(.feature__image) {
    flex: 0 0 9rem;
    width: 9rem;
    height: 9rem;
    object-fit: cover;
    background: var(--sand);
  }
  .feature__main {
    flex: 1 1 14rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .feature__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    line-height: normal;
    color: var(--blue);
  }
  .feature__title {
    margin: 0;
    font-size: var(--step-s);
    line-height: 1.25;
  }
  .feature__meta {
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--blue);
  }
  .feature__summary {
    font-size: var(--step-small);
    line-height: 1.55;
  }
  .feature__summary :global(p) {
    margin: 0;
  }
  .feature__cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
