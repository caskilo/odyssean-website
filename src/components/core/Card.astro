---
import type { Copy } from '../../lib/copy';
import CopyText from './Copy.astro';

interface Props {
  href: string;
  rule?: 'blue' | 'gold' | 'navy';
  label: Copy;
  title: Copy;
  note?: Copy;
  /** shown on hover or keyboard focus; always shown where there is no hover (touch) */
  reveal?: Copy;
}
const { href, rule = 'blue', label, title, note, reveal } = Astro.props;
---

<a class:list={['card', `card--${rule}`, { 'card--reveal': reveal }]} {href}>
  <span class="card__label">
    <CopyText value={label} />
  </span>
  <span class="card__title">
    <CopyText value={title} />
  </span>
  {note && (
    <span class="card__note">
      <CopyText value={note} />
    </span>
  )}
  {reveal && (
    <span class="card__reveal">
      <span class="card__reveal-inner">
        <CopyText value={reveal} />
      </span>
    </span>
  )}
</a>

<style>
  .card {
    flex: 1 1 18.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2rem;
    background: var(--paper-light);
    color: var(--navy);
    text-decoration: none;
    border-top: 3px solid var(--blue);
  }
  .card:hover {
    color: var(--navy);
    background: #fbf8f2;
  }
  .card--gold {
    border-top-color: var(--gold);
  }
  .card--navy {
    border-top-color: var(--navy);
  }
  .card__label {
    line-height: normal;
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    color: var(--blue);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: var(--step-s);
    line-height: 1.3;
  }
  .card__note {
    line-height: normal;
    font-size: 0.875rem;
    color: var(--blue);
  }
  .card__reveal {
    display: grid;
    grid-template-rows: 1fr;
    font-size: var(--step-small);
    line-height: 1.55;
  }
  .card__reveal-inner {
    min-height: 0;
    overflow: hidden;
    padding-top: 0.875rem;
    border-top: 1px solid var(--sand);
  }
  @media (hover: hover) {
    .card--reveal .card__reveal {
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.25s ease,
        opacity 0.25s ease;
    }
    .card--reveal .card__reveal-inner {
      padding-top: 0;
      border-top-color: transparent;
    }
    .card--reveal:hover .card__reveal,
    .card--reveal:focus-visible .card__reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .card--reveal:hover .card__reveal-inner,
    .card--reveal:focus-visible .card__reveal-inner {
      padding-top: 0.875rem;
      border-top-color: var(--sand);
    }
  }
</style>
