---
import { text, type Copy } from '../../lib/copy';
import { markCurrent } from '../../lib/site';
import CopyText from './Copy.astro';

interface Props {
  label: Copy;
  /** where the label itself goes; without it the label is a button that only opens the menu */
  href?: string;
  /** each group may carry a heading, which is not a link */
  groups: { label?: Copy; items: { label: Copy; href: string }[] }[];
  current: string;
}
const { label, href, groups, current } = Astro.props;
const shown = groups.map((g) => ({ ...g, links: markCurrent(g.items, current) }));
const hrefs = [...(href ? [href] : []), ...groups.flatMap((g) => g.items.map((i) => i.href))];
const within = hrefs.some((h) => current === h || current.startsWith(h + '/'));
const state = href && current === href ? 'page' : within ? 'true' : undefined;
const Trigger = href ? 'a' : 'button';
---

<div class="drop" data-drop>
  <Trigger
    class="drop__trigger"
    {...(href ? { href } : { type: 'button' })}
    aria-haspopup="true"
    aria-current={state}
  >
    <CopyText value={label} />
    <svg class="drop__chevron" viewBox="0 0 10 6" aria-hidden="true">
      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </Trigger>
  <div class="drop__panel">
    {shown.map((g) => (
      <div class="drop__group" role={g.label ? 'group' : undefined} aria-label={text(g.label)}>
        {g.label && (
          <p class="drop__label" aria-hidden="true">
            <CopyText value={g.label} />
          </p>
        )}
        <ul>
          {g.links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current}>
                <CopyText value={l.label} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .drop {
    position: relative;
  }
  .drop__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0 0 3px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--nav-link);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .drop__chevron {
    width: 0.625rem;
    height: 0.375rem;
    transition: transform 0.2s ease;
  }
  .drop:hover .drop__chevron,
  .drop:focus-within .drop__chevron {
    transform: rotate(180deg);
  }
  /* the panel starts at the bottom edge of the trigger, with its own top padding, so the pointer never leaves the menu on the way down */
  .drop__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: -1rem;
    z-index: 30;
    min-width: 13.5rem;
    margin: 0;
    padding: 0.875rem 0 0;
    list-style: none;
  }
  .drop:hover .drop__panel,
  .drop:focus-within .drop__panel {
    display: block;
  }
  .drop[data-dismissed] .drop__panel {
    display: none;
  }
  .drop__panel::before {
    position: absolute;
    inset: 0.875rem 0 0;
    z-index: -1;
    background: var(--h-bg);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--h-fg) 14%, transparent),
      0 1.25rem 2rem -1rem rgb(1 17 48 / 0.45);
    content: '';
  }
  .drop__panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drop__group + .drop__group {
    border-top: 1px solid color-mix(in srgb, var(--h-fg) 18%, transparent);
  }
  .drop__label {
    margin: 0;
    padding: 0.75rem 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: normal;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .drop__panel a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--h-fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .drop__panel a:hover,
  .drop__panel a[aria-current] {
    color: var(--h-current);
  }
</style>
