---
import arrus from '../assets/fonts/ArrusBT-400.otf?url';
import arrusItalic from '../assets/fonts/ArrusBT-400i.otf?url';
import instrument from '../assets/fonts/InstrumentSans-500.woff2?url';
import mono from '../assets/fonts/DMMono-400.woff2?url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/themes/info.css';
import '../styles/themes/grain.css';
import '../styles/themes/scans.css';
import '../styles/themes/process.css';
import '../styles/themes/af.css';
import '../styles/base.css';
import Header from '../components/core/Header.astro';
import Footer from '../components/core/Footer.astro';
import { text, type Copy } from '../lib/copy';
import { getSettings, isMicrosite, logoTone, type Strand } from '../lib/site';

interface Props {
  title: Copy;
  /** use the title as-is (home); otherwise "<title> | <site name>" */
  fullTitle?: boolean;
  description?: Copy;
  strand: Strand;
  headerVariant?: 'overlay' | 'bar' | 'plain';
  /** dark variant of the strand theme (Modelling) */
  dark?: boolean;
  /** lighter page ground (Reading family) */
  lightGround?: boolean;
  noindex?: boolean;
  /** blog posts: Open Graph article metadata */
  article?: { published: Date; image?: string };
  /** use the narrower content grid in the header (inner pages) */
  narrow?: boolean;
}
const {
  title,
  fullTitle = false,
  description,
  strand,
  headerVariant = 'plain',
  dark = false,
  lightGround = false,
  noindex = false,
  article,
  narrow = false,
} = Astro.props;

const s = await getSettings();
// built pages are files (about.html), so strip the extension to get the public path
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/[/](index)?$/, '') || '/';
const micro = isMicrosite(strand) ? s.microsites[strand] : undefined;
// a microsite with no sub-nav (a single page) shows the main links
const section = micro?.subnav ? { name: micro.name, links: micro.subnav } : { links: s.mainNav };
const pageTitle = text(title) ?? s.name;
const documentTitle = fullTitle ? pageTitle : `${pageTitle} | ${s.name}`;
const desc = text(description);
const tone =
  headerVariant === 'plain'
    ? logoTone(strand, dark)
    : headerVariant === 'overlay'
      ? 'gold'
      : 'paper';
const ui = {
  home: String(s.ui.home),
  menu: String(s.ui.menu),
  nav: String(micro?.subnav ? s.ui.subNav : s.ui.mainNav),
};
const canonical = new URL(current, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {desc && <meta name="description" content={desc} />}
    {noindex && <meta name="robots" content="noindex" />}
    {[
      [arrus, 'font/otf'],
      [arrusItalic, 'font/otf'],
      [instrument, 'font/woff2'],
      [mono, 'font/woff2'],
    ].map(([href, type]) => (
      <link rel="preload" as="font" {type} {href} crossorigin />
    ))}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:title" content={documentTitle} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <meta property="article:published_time" content={article.published.toISOString()} />
    )}
    <meta
      property="og:image"
      content={article?.image ?? new URL('/og-default.png', Astro.site).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={s.name} href="/blog-feed.xml" />
    <meta name="theme-color" content="#011130" />
  </head>
  <body
    data-theme={strand}
    data-variant={dark ? 'dark' : undefined}
    style={lightGround ? '--bg: var(--paper-light)' : undefined}
  >
    <a class="skip-link" href="#main">
      {String(s.ui.skip)}
    </a>
    <Header
      variant={headerVariant}
      {current}
      {section}
      projects={s.projects}
      more={s.more}
      logoTone={tone}
      {narrow}
      {ui}
    />
    <main id="main">
      <slot />
    </main>
    <Footer
      name={s.name}
      charityLine={s.charityLine}
      charityNumber={s.charityNumber}
      charityNumberLabel={s.charityNumberLabel}
      email={s.email}
      copyright={s.copyright}
      columns={s.footer}
      ui={{ footerNav: String(s.ui.footerNav) }}
    />
  </body>
</html>
