---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import Headline from '../../components/core/Headline.astro';
import Prose from '../../components/core/Prose.astro';
import { excerpt, getPosts, monthYear } from '../../lib/content';
import { text } from '../../lib/copy';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const iso = data.published.toISOString();
const cover = data.cover && (await getImage({ src: data.cover.src, width: 1200 }));
const article = {
  published: data.published,
  image: cover && new URL(cover.src, Astro.site).href,
};
---

<Reading title={data.title} description={data.description ?? excerpt(post.body)} {article}>
  <article class="post">
    <header class="post__head">
      <p class="post__meta">
        <span>{data.author}</span>
        <time datetime={iso}>{monthYear(data.published)}</time>
        {data.readTime && <span>{data.readTime}</span>}
      </p>
      <Headline text={data.title} size="l" />
    </header>
    {data.cover && (
      <figure class="post__cover">
        <Image src={data.cover.src} alt={text(data.cover.alt) ?? ''} width={1100} />
      </figure>
    )}
    <Prose>
      <Content />
    </Prose>
  </article>
</Reading>

<style>
  .post {
    max-width: 46rem;
    margin-inline: auto;
  }
  .post__head {
    margin-bottom: 2rem;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    letter-spacing: 0.04em;
    color: var(--blue);
  }
  .post__cover {
    margin: 0 0 2rem;
  }
  .post__cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
