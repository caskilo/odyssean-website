{
  "name": "odyssean-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node tools/redirects/htaccess.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract": "node tools/extract/run.mjs",
    "verify:content": "node tools/verify/content.mjs",
    "report:content-map": "node tools/report/content-map.mjs",
    "report:placeholders": "node tools/report/placeholders.mjs",
    "verify:visual": "node tools/verify/visual.mjs",
    "shots": "node tools/verify/shots.mjs",
    "verify:behaviour": "node tools/verify/behaviour.mjs",
    "verify:responsive": "node tools/verify/responsive.mjs",
    "verify:built": "node tools/verify/built.mjs",
    "verify:redirects": "node tools/verify/redirects.mjs",
    "verify:a11y": "node tools/verify/a11y.mjs",
    "verify:lighthouse": "node tools/verify/lighthouse.mjs",
    "verify:links": "node tools/verify/links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
