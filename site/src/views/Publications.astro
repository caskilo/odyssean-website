---
import Reading from '../layouts/Reading.astro';
import PageTitle from '../components/core/PageTitle.astro';
import RegisterRow from '../components/core/RegisterRow.astro';
import Button from '../components/core/Button.astro';
import CopyText from '../components/core/Copy.astro';
import { getPublications, type PageOf } from '../lib/content';
import { isRequest, text } from '../lib/copy';
import { md } from '../lib/markdown';

interface Props {
  entry: PageOf<'publications'>;
}
const { data } = Astro.props.entry;
const all = await getPublications();
const featured = all.find((p) => p.id === data.featured.publication);
if (!featured) throw new Error(`featured publication "${data.featured.publication}" not found`);
const rows = all.filter((p) => p !== featured);
const link = (p: (typeof all)[number]) => (p.data.file ?? p.data.url)!;
const meta = (p: (typeof all)[number]) =>
  [p.data.authors, p.data.date].filter((v) => v && !isRequest(v)) as string[];
const featuredDate = text(featured.data.date);
---

<Reading title={data.title} description={data.description}>
  <PageTitle eyebrow={data.eyebrow} title={data.heading} />
  <div class="register" data-filter>
    <aside class="register__filters">
      <div class="register__filter-label">
        <CopyText value={data.filterLabel} />
      </div>
      {data.filters.map((f) => (
        <a
          class="register__filter"
          href={f.href ?? `#${f.type}`}
          {...(f.type ? { 'data-filter-link': f.type } : {})}
          aria-current={f.type === 'all' ? 'true' : undefined}
        >
          <CopyText value={f.label} />
        </a>
      ))}
    </aside>
    <div class="register__list">
      <article class="featured" data-type={featured.data.type}>
        <div class="featured__cover" aria-hidden="true">
          <span class="featured__kicker">
            <CopyText value={data.featured.cover.kicker} />
          </span>
          <span class="featured__cover-title">
            <CopyText value={data.featured.cover.title} />
          </span>
          <span class="featured__rule"></span>
        </div>
        <div class="featured__main">
          <div class="featured__label">
            <CopyText value={data.featured.label} />
          </div>
          <h2 class="featured__title">
            <CopyText value={data.featured.title} />
          </h2>
          <p class="featured__summary">
            <CopyText value={data.featured.summary} />
          </p>
          <div class="featured__actions">
            <Button href={link(featured)} size="small">
              <CopyText value={data.featured.cta} />
            </Button>
            <span class="featured__file">
              <CopyText value={data.featured.fileLabel} />
              {featuredDate && ` · ${featuredDate}`}
            </span>
          </div>
        </div>
      </article>
      {await Promise.all(
        rows.map(async (p) => (
          <div data-type={p.data.type}>
            <RegisterRow
              type={data.typeLabels[p.data.type]}
              title={p.data.title}
              href={link(p)}
              meta={meta(p)}
            >
              <Fragment set:html={await md(p.data.summary)} />
            </RegisterRow>
          </div>
        )),
      )}
    </div>
  </div>
</Reading>

<script>
  import '../scripts/filter';
</script>

<style>
  .register {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
  }
  .register__filters {
    flex: 1 1 12.5rem;
    max-width: 15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step-small);
  }
  .register__filter-label {
    margin-bottom: 0.375rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--navy);
    font-family: var(--font-mono);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--blue);
    line-height: normal;
  }
  .register__filter {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--sand);
    color: var(--navy);
    text-decoration: none;
    line-height: normal;
  }
  .register__filter:last-child {
    border-bottom: 0;
  }
  .register__filter[aria-current='true'] {
    font-weight: 600;
  }
  .register__filter:hover {
    color: var(--blue);
  }
  .register__list {
    flex: 999 1 35rem;
    min-width: 0;
  }
  .featured {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding-bottom: 2.25rem;
    border-bottom: 1.5px solid var(--navy);
  }
  .featured__cover {
    flex: 0 0 11.25rem;
    height: 15rem;
    padding: 1.125rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--blue);
    color: var(--paper);
  }
  .featured__kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: normal;
    text-transform: uppercase;
    color: var(--sand);
  }
  .featured__cover-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.15;
  }
  .featured__rule {
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--gold);
  }
  .featured__main {
    flex: 1 1 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .featured__label {
    font-family: var(--font-mono);
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    line-height: normal;
    color: var(--blue);
  }
  .featured__title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.125rem);
    line-height: 1.15;
  }
  .featured__summary {
    max-width: 37.5rem;
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }
  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    margin-top: 0.375rem;
  }
  .featured__file {
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    color: var(--blue);
  }
</style>
