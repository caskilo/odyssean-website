---
import Base from './Base.astro';
import type { Copy } from '../lib/copy';

interface Props {
  title: Copy;
  fullTitle?: boolean;
  description?: Copy;
  noindex?: boolean;
  headerVariant?: 'overlay' | 'plain';
  narrow?: boolean;
}
const props = Astro.props;
---

<Base {...props} strand="info">
  <slot />
</Base>
