---
import CopyText from './core/Copy.astro';
import type { PageOf } from '../lib/content';

interface Props {
  form: NonNullable<PageOf<'prose'>['data']['form']>;
}
const { form } = Astro.props;
---

<form class="form" method="post" action="/contact.php" data-form>
  {form.fields.map((f) => (
    <div class="form__field">
      <label for={`f-${f.name}`}>
        <CopyText value={f.label} />
        {f.required && <span aria-hidden="true"> *</span>}
      </label>
      {f.type === 'textarea' ? (
        <textarea id={`f-${f.name}`} name={f.name} rows="6" required={f.required} />
      ) : (
        <input id={`f-${f.name}`} name={f.name} type={f.type} required={f.required} />
      )}
    </div>
  ))}
  <div class="form__trap" aria-hidden="true">
    <input name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="form__submit" type="submit">
    <CopyText value={form.submit} />
  </button>
  <p class="form__success" role="status" hidden>
    <CopyText value={form.success} />
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form && new URLSearchParams(location.search).has('sent')) {
    form.querySelector<HTMLElement>('.form__success')!.hidden = false;
  }
</script>

<style>
  .form {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    margin-top: 2rem;
  }
  .form__field {
    display: grid;
    gap: 0.375rem;
  }
  label {
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  input,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1.5px solid var(--navy);
    border-radius: var(--radius);
    background: var(--paper-light);
    color: var(--navy);
    font: inherit;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .form__trap {
    position: absolute;
    left: -9999px;
  }
  .form__submit {
    justify-self: start;
    padding: 1rem 1.625rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 600;
    cursor: pointer;
  }
  .form__submit:hover {
    filter: brightness(1.25);
  }
  .form__success {
    margin: 0;
    font-weight: 600;
  }
</style>
