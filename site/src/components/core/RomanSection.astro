---
import type { Copy } from '../../lib/copy';
import CopyText from './Copy.astro';

interface Props {
  numeral: string;
  title: Copy;
  body: Copy;
}
const { numeral, title, body } = Astro.props;
---

<section class="roman">
  <span class="roman__numeral" aria-hidden="true">
    {numeral}
  </span>
  <div class="roman__text">
    <h2 class="roman__title">
      <CopyText value={title} />
    </h2>
    <p class="roman__body">
      <CopyText value={body} />
    </p>
  </div>
</section>

<style>
  .roman {
    display: flex;
    gap: 1.375rem;
  }
  .roman__numeral {
    min-width: 2.5rem;
    font-family: var(--font-display);
    font-size: 2.125rem;
    line-height: 1.1;
    color: var(--accent);
  }
  .roman__text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .roman__title {
    margin: 0;
    font-size: var(--step-s);
  }
  .roman__body {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
</style>
