---
interface Props {
  /** one label per track, in rank order (the five concept tracks) */
  numbers: string[];
  origin: string;
  description: string;
}
const { numbers, origin, description } = Astro.props;
const tracks = [
  {
    d: 'M120 340 C260 260 420 100 640 70 C700 62 718 104 690 122 C668 136 650 112 668 102',
    x: 640,
    y: 52,
  },
  {
    d: 'M120 340 C300 300 480 220 700 210 C744 208 748 252 716 258 C694 262 690 238 706 234',
    x: 726,
    y: 206,
  },
  {
    d: 'M120 340 C320 360 500 380 690 430 C732 442 724 482 692 474 C672 468 676 446 692 450',
    x: 704,
    y: 420,
  },
  {
    d: 'M120 340 C260 430 380 560 560 600 C602 610 612 580 588 570 C570 563 562 582 576 586',
    x: 604,
    y: 620,
  },
  {
    d: 'M120 340 C200 260 250 160 330 80 C352 58 384 72 370 96 C360 112 344 100 352 90',
    x: 384,
    y: 70,
  },
];
if (numbers.length !== tracks.length)
  throw new Error(`signal-tracks draws ${tracks.length} tracks, got ${numbers.length}`);
---

<svg viewBox="0 0 760 640" class="art" role="img" aria-label={description}>
  <g fill="none" stroke="#EBD3A2" stroke-width="0.8" stroke-opacity="0.18">
    <path d="M120 340 C180 300 230 330 210 370 C190 405 150 380 165 355"></path>
    <path d="M120 340 C60 280 40 200 90 160 C130 130 160 170 135 190"></path>
    <path d="M120 340 C70 420 90 520 170 560 C220 585 240 540 205 530"></path>
    <path d="M120 340 C200 380 260 460 250 540"></path>
    <path d="M120 340 C240 260 300 160 420 120 C470 104 480 150 450 160"></path>
    <path d="M120 340 C300 300 520 330 600 380 C640 405 620 440 590 425"></path>
  </g>
  {tracks.map((t, i) => (
    <path
      class="track"
      data-track={i}
      d={t.d}
      fill="none"
      stroke="#E2B540"
      stroke-linecap="round"
    />
  ))}
  <circle cx="120" cy="340" r="9" fill="#011130" stroke="#EBE5D9" stroke-width="2"></circle>
  <circle cx="120" cy="340" r="3" fill="#E2B540"></circle>
  <text
    x="120"
    y="378"
    fill="#EBD3A2"
    font-family="DM Mono, monospace"
    font-size="12"
    class="origin"
    text-anchor="middle"
    style="text-transform: uppercase"
  >
    {origin}
  </text>
  {tracks.map((t, i) => (
    <text
      class="num"
      data-track={i}
      x={t.x}
      y={t.y}
      fill="#EBD3A2"
      font-family="DM Mono, monospace"
      font-size="12"
    >
      {numbers[i]}
    </text>
  ))}
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
  }
  .track {
    stroke-width: 1.4;
    stroke-opacity: 0.35;
  }
  .num {
    fill-opacity: 0.35;
  }
  /* phone width: keep the labels legible (mobile: interim) */
  @media (max-width: 40rem) {
    .num,
    .origin {
      font-size: 26px;
    }
  }
  .track.is-active {
    stroke-width: 3.5;
    stroke-opacity: 1;
  }
  .num.is-active {
    fill-opacity: 1;
  }
</style>
