---
import { getCollection } from 'astro:content';
import Home from '../views/Home.astro';
import Projects from '../views/Projects.astro';
import Publications from '../views/Publications.astro';
import About from '../views/About.astro';
import Focus from '../views/Focus.astro';
import Faq from '../views/Faq.astro';
import Blog from '../views/Blog.astro';
import ProsePage from '../views/ProsePage.astro';
import GrainLanding from '../views/GrainLanding.astro';
import ScansLanding from '../views/ScansLanding.astro';
import ProcessLanding from '../views/ProcessLanding.astro';
import Modelling from '../views/Modelling.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const views = {
  home: Home,
  projects: Projects,
  publications: Publications,
  about: About,
  focus: Focus,
  faq: Faq,
  blog: Blog,
  prose: ProsePage,
  'grain-landing': GrainLanding,
  'scans-landing': ScansLanding,
  'process-landing': ProcessLanding,
  modelling: Modelling,
};
const View = views[entry.data.template];
---

<View entry={entry as never} />
